  "limitations": [
    {
      "severity": "limitation",
      "topic": "measurement variance",
      "finding": "intensity_se2 = noise_gray^2/interior_n is exactly implemented, but is an iid pixel-noise approximation; it excludes within-grain offsets, correlated pixel noise, segmentation error and noise-estimator uncertainty. Do not treat it as empirically calibrated total measurement variance."
    },
    {
      "severity": "limitation",
      "topic": "shared shade uncertainty",
      "finding": "shade_se2 uses squared local smoothing weights times robust bright-grain spread. It omits common-reference uncertainty, grain covariance, bright-membership selection and centering correction covariance. Distribution kernels should include a sensitivity/control test; uncertainty values are proxies."
    },
    {
      "severity": "limitation",
      "topic": "frozen zero-shot provenance",
      "finding": "segment.py and segment_v3.py invoke fixed Cellpose-SAM pretrained weights and no hardness target/fine-tuning; v3 coverage retry uses each image only. Provenance verifies cached mask hash, but this audit did not rerun segmentation or independently authenticate pretrained weights."
    },
    {
      "severity": "limitation",
      "topic": "segmentation selection",
      "finding": "Objects under 12 pixels are omitted and weight normalization is over retained objects, with pore objects still present in object bags. Zero-shot segmentation quality may limit high-noise performance; coverage/fallback are retained."
    },
    {
      "severity": "limitation",
      "topic": "model evaluation",
      "finding": "common.evaluate uses correct image-grouped resampling across three repeats, but intervals condition on reused development data/models. The baseline feature path contains legacy fitted features; the new object bank itself uses no fitted U-Net or fine-tuned mask input."
    }
  ],
  "scope": "read-only audit of root and legacy inputs; only this report written"
}
