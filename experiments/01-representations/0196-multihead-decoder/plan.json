{
  "study": 196,
  "created_UTC": "2026-10-06T11:36:07.957195+00:00",
  "status": "fixed_before_any_training_or_score",
  "authorization": "Parent explicitly authorizes small MHA decoder versus genuinely parameter-matched mean pooling on cached original400, smoke/audit/resource gate first, then fixed budget5fold. No rescue sweep or data expansion.",
  "hypothesis": "Four query slots can collect different head-wise patch summaries and then exchange information through sample-dependent query self-attention, beyond identical uniform mean mixing. Test a small relational readout of frozen features.",
  "difference_from092": "092 used one local scalar gated score tanh(Vh)*sigmoid(Uh) per patch and one pooled vector; no dot-product heads, multiple learned query slots or query-to-query attention.196 uses4 heads x4 learned query slots, patch cross-attention followed by query self-attention. Frozen DINO tokens themselves already contain backbone self-attention; this is only an extra readout hypothesis, not newly learned patch features or proof of physical interaction.",
  "references": [
    "https://arxiv.org/abs/1706.03762",
    "https://docs.pytorch.org/docs/2.14/generated/torch.nn.MultiheadAttention.html"
  ],
  "arms": [
    "mean",
    "mha"
  ],
  "architecture": {
    "input": "Existing092 final normalized float32 DINO-B504 tokens1296x768 plus same fixed grid(x,y) in[-1,1]. No CLS/intermediate features or other branch information in either arm. Whole token-coordinate pairs retained; no patch subsampling, augmentation or learned backbone.",
    "project": "Linear770->32, GELU, LayerNorm32(eps1e-5). Four learned32D query slots initialized normal std.02.",
    "cross": "Split32 into4 heads of8. One trainable bias-free32x32 W_c shared for Q=query@W_c, K=H@W_c, V=H@W_c. MHA head output=softmax(Q K.T/sqrt8)V; mean head output=mean(V) broadcast to4queries. Concatenate heads, shared Linear32->32, Dropout.25 and query residual. Then LayerNorm32, Linear32->64,GELU,Dropout.25,Linear64->32,Dropout.25 and residual.",
    "self": "LayerNorm32 on4 updatedqueries; a separate bias-free32x32 W_s sharedQ=K=V. Same4head scaled dot-product mixing forMHA or uniform mean across4 forcontrol; Linear32->32,Dropout.25,residual. Same LN/32->64->32 FFN residual as cross.",
    "readout": "LayerNorm32, mean over4queries, Linear32->16,GELU,Dropout.25,Linear16->1.",
    "parameter_fairness": "Both exact same tensors/shapes/initial states. SharedQKV projection weights also act on values in meancontrol; learned queries affect residual plus nonlinear decoder/head in both. No separate unusedQ/K parameter, dummy tensor, padding or zero-learning-rate branch. Every parameter tensor must receive finite nonzero regression gradients in both arms before maintraining.",
    "expected_trainable_parameters_each": 38209,
    "only_arm_difference": "content-dependent attention weights versus uniform mixing in both cross and query-self aggregation. Meancontrol retains same query-slot residuals/nonlinear layers, so it is a matched decoder control, not a weaker plain-average linear head.",
    "attention_dropout": "None in both; all dropout occurs on identical shapes at common output/FFN/head sites. QKV tying is a precommitted capacity constraint, not the general independent-projection Transformer implementation."
  },
  "preprocessing": "Training320 only: use existing float64 per-image token first/second moments to obtain channel mean and variance across all train patches; scale_j=max(sqrt(var_j),sqrt(mean(var))), allzero scale1. Fixedcoords unscaled. Target mean/population std from training labels only. Model buffers float32; evaluation normalizedfloat32 output castfloat64 before inverse target transform. No clipping/PCA/targetbins.",
  "recipe": {
    "width": 32,
    "heads": 4,
    "queries": 4,
    "ff_width": 64,
    "dropout": 0.25,
    "query_init_std": 0.02,
    "epochs": 20,
    "effective_batch": 16,
    "microbatch": 2,
    "updates_per_model": 400,
    "loss": "SmoothL1 beta1 on standardizedtarget",
    "optimizer": "AdamW",
    "lr": 0.001,
    "min_lr": 1e-05,
    "weight_decay": 0.1,
    "gradient_clip_norm": 1.0,
    "seed": 202710196,
    "schedule": "At epoch e=0..19, min_lr+.5*(lr-min_lr)*(1+cos(pi*e/20)).",
    "checkpoint": "Fixed final epoch20; no validation scoring duringtraining, earlystop, checkpoint averaging or selection."
  },
  "pairing": "Same seed202710196+fold initializes whole CPU model then moveMPS; same allweights,buffers,targetstats. Same fixed NumPy epochpermutations, batchorder, LR schedule,400updates. Set torch.manual_seed(202710196+fold+10000*(epoch+1)+micro_start_index) per microbatch for identical dropout streams. Both consume identical raw tokens/coords. Compute time can differ; update and data exposure budgets match.",
